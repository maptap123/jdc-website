      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "p", "value": "676" }],
      "destination": "/remodeling.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page_id", "value": "26" }],
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page_id", "value": "30" }],
      "destination": "/quote.html",
      "permanent": true
    }
  ]
}
